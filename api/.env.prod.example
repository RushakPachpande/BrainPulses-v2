# Live server API settings. Copy to api/.env.prod (do not commit the real file).
# Replace every REPLACE_… / replace-me value before going live.

# production = live server
NODE_ENV=production
# 127.0.0.1 = only nginx on this machine talks to the API
HOST=127.0.0.1
# Port nginx should forward to
PORT=3002

# Database connection — use the same password as POSTGRES_PASSWORD in the root .env
DATABASE_URL=postgresql://brainpulses:REPLACE_DB_PASSWORD@127.0.0.1:5434/brainpulses?schema=public
# Cache/queue connection — use the same password as REDIS_PASSWORD in the root .env
REDIS_URL=redis://:REPLACE_REDIS_PASSWORD@127.0.0.1:6381

# Secret used to sign login tokens — at least 32 random characters
JWT_SECRET=replace-with-at-least-32-random-characters

# Public website addresses allowed to call this API (comma-separated)
CORS_ORIGIN=https://admin.brainpulses.com,https://participant.brainpulses.com
# true = cookies only sent over https (required live)
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
# 1 = one proxy in front (nginx → API)
TRUST_PROXY=1

# Folder where uploaded images are stored
UPLOAD_DIR=./uploads

# false = background jobs need the separate PM2 worker process
QUEUE_INLINE=false

# SMS login for participants — required on the live server
TWILIO_ENABLED=true
TWILIO_ACCOUNT_SID=replace-me
TWILIO_AUTH_TOKEN=replace-me
TWILIO_FROM_NUMBER=+1xxxxxxxxxx
