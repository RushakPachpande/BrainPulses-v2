# BrainPulses API — production template.
# Copy to api/.env.prod (never commit the real file).
# Replace every placeholder before deploying.
# Loaded when NODE_ENV=production (pm2 start … --env production).

NODE_ENV=production
# Bind loopback only; nginx on the same host terminates TLS.
HOST=127.0.0.1
PORT=3002

# Host ports from docker-compose.yml (loopback-mapped).
DATABASE_URL=postgresql://brainpulses:REPLACE_DB_PASSWORD@127.0.0.1:5434/brainpulses?schema=public
REDIS_URL=redis://:REPLACE_REDIS_PASSWORD@127.0.0.1:6381

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=brainpulses-api
JWT_AUDIENCE=brainpulses-admin
JWT_ACCESS_EXPIRES_IN=15m
PARTICIPANT_JWT_ACCESS_EXPIRES_IN=4h
JWT_ORG_SELECT_EXPIRES_IN=5m
REFRESH_TOKEN_TTL_SECONDS=604800

CORS_ORIGIN=https://admin.brainpulses.com,https://participant.brainpulses.com
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

UPLOAD_DIR=./uploads
FILE_DOWNLOAD_TTL_SECONDS=300
# Unset uses 10MB for images and 5MB for question and answer images.
UPLOAD_IMAGE_SIZE_CAPPING=10MB
QA_UPLOAD_IMAGE_SIZE_CAPPING=5MB

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=20
REQUEST_TIMEOUT_MS=30000
# One hop: nginx → Node
TRUST_PROXY=1

DASHBOARD_CACHE_TTL_SECONDS=60

# Twilio SMS OTP (participant phone login) — required when NODE_ENV=production
TWILIO_ENABLED=true
TWILIO_ACCOUNT_SID=replace-me
TWILIO_AUTH_TOKEN=replace-me
TWILIO_FROM_NUMBER=+1xxxxxxxxxx
