# Live API settings. Copy to api/.env.prod (do not commit the real file).
# Replace every placeholder before going live.

# --- Required ---

# Marks this as the live server
NODE_ENV=production
# 127.0.0.1 = only nginx on this machine may talk to the API
HOST=127.0.0.1
# Port nginx forwards to
PORT=3002
# Postgres connection — password must match POSTGRES_PASSWORD in the root .env
DATABASE_URL=postgresql://brainpulses:REPLACE_DB_PASSWORD@127.0.0.1:5434/brainpulses?schema=public
# Redis connection — password must match REDIS_PASSWORD in the root .env
REDIS_URL=redis://:REPLACE_REDIS_PASSWORD@127.0.0.1:6381
# Signs login tokens — at least 32 random characters
JWT_SECRET=replace-with-at-least-32-random-characters
# Public websites allowed to call this API (comma-separated)
CORS_ORIGIN=url_of_the_admin_website,url_of_the_participant_website
# true = login cookies only sent over HTTPS
COOKIE_SECURE=true
# 1 = one proxy in front (nginx → API); needed for real client IPs and rate limits
TRUST_PROXY=1
# false = registration ID only (API still starts). true = also show phone SMS login
TWILIO_ENABLED=false
# Required only when TWILIO_ENABLED=true. Twilio account id (from Twilio console)
TWILIO_ACCOUNT_SID=replace-me
# Twilio auth token (from Twilio console)
TWILIO_AUTH_TOKEN=replace-me
# Twilio phone number that sends the SMS
TWILIO_FROM_NUMBER=+1xxxxxxxxxx

# --- Optional ---

# How the browser sends cookies across sites (default: lax)
COOKIE_SAME_SITE=lax
# Folder on disk for uploaded images (default: ./uploads)
UPLOAD_DIR=./uploads
# false = background jobs run in the separate PM2 worker process
QUEUE_INLINE=false
