# BrainPulses API — production template.
# Copy to api/.env.prod (never commit the real file).
# Replace every placeholder before deploying.

NODE_ENV=production
HOST=0.0.0.0
PORT=3002

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/brainpulses?schema=public
REDIS_URL=redis://:PASSWORD@HOST:6379

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=brainpulses-api
JWT_AUDIENCE=brainpulses-admin
JWT_ACCESS_EXPIRES_IN=15m
STUDENT_JWT_ACCESS_EXPIRES_IN=4h
JWT_ORG_SELECT_EXPIRES_IN=5m
REFRESH_TOKEN_TTL_SECONDS=604800

CORS_ORIGIN=https://admin.example.com,https://student.example.com
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

UPLOAD_DIR=./uploads
FILE_DOWNLOAD_TTL_SECONDS=300

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=20
REQUEST_TIMEOUT_MS=30000
# Hop count for reverse proxies (e.g. 1 for a single nginx/ALB hop)
TRUST_PROXY=1

DASHBOARD_CACHE_TTL_SECONDS=60

# Twilio SMS OTP (student phone login)
TWILIO_ENABLED=true
TWILIO_ACCOUNT_SID=replace-me
TWILIO_AUTH_TOKEN=replace-me
TWILIO_FROM_NUMBER=+1xxxxxxxxxx
