{
  "name": "brainpulses-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#prisma": {
      "development": "./src/generated/prisma/client.ts",
      "default": "./dist/generated/prisma/client.js"
    }
  },
  "scripts": {
    "dev": "nodemon",
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "dev:worker": "node --conditions=development --import tsx src/worker.ts",
    "typecheck": "tsc --noEmit && tsc -p prisma/tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "test": "node --conditions=development --import tsx --import ./test/setup.ts --test --test-concurrency=1 --test-force-exit test/**/*.test.ts",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "node --conditions=development --import tsx prisma/seed.ts",
    "uploads:relocate": "node --conditions=development --import tsx src/scripts/relocate-uploads.ts",
    "db:reset": "prisma migrate reset --force"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "nodemon": {
      "chokidar": "^4.0.3"
    },
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.7.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "dotenv": "^18.0.9",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "libphonenumber-js": "^1.13.15",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "rate-limit-redis": "^6.0.2",
    "temporal-polyfill": "^1.0.8",
    "twilio": "^6.3.0",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1"
  }
}
