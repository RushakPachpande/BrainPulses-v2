# BrainPulses API — local development.
# Copy to api/.env.dev (never commit the real file).
# Values match docker-compose.yml defaults.

NODE_ENV=development
# Bind all interfaces so phones/laptops on the LAN can reach the API.
HOST=0.0.0.0
PORT=3002


DATABASE_URL=postgresql://brainpulses:brainpulses@127.0.0.1:5434/brainpulses?schema=public
REDIS_URL=redis://:brainpulses@127.0.0.1:6381

JWT_SECRET=change-me-to-a-long-random-secret
JWT_ISSUER=brainpulses-api
JWT_AUDIENCE=brainpulses-admin
JWT_ACCESS_EXPIRES_IN=15m
STUDENT_JWT_ACCESS_EXPIRES_IN=4h
JWT_ORG_SELECT_EXPIRES_IN=5m
REFRESH_TOKEN_TTL_SECONDS=604800

# Explicit SPA origins. Outside production, RFC1918 LAN origins are also allowed.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax


UPLOAD_DIR=./uploads
FILE_DOWNLOAD_TTL_SECONDS=300
# Unset uses 10MB for images and 5MB for question and answer images.
UPLOAD_IMAGE_SIZE_CAPPING=10MB
QA_UPLOAD_IMAGE_SIZE_CAPPING=5MB

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=20
REQUEST_TIMEOUT_MS=30000
# 0 = direct connections; set hop count when behind a reverse proxy
TRUST_PROXY=0

DASHBOARD_CACHE_TTL_SECONDS=60

# Twilio SMS OTP (student phone login). Leave disabled for local; OTP is logged to the API console.
TWILIO_ENABLED=false
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
