# Local API settings. Copy to api/.env.dev (do not commit the real file).

# --- Required ---

# Marks this as a local run (not the live server)
NODE_ENV=development
# 0.0.0.0 = phones/laptops on your Wi‑Fi can reach the API
HOST=0.0.0.0
# Port the API listens on (keep in sync with admin/participant)
PORT=3002
# Postgres connection string (must match Docker Compose)
DATABASE_URL=postgresql://brainpulses:brainpulses@127.0.0.1:5434/brainpulses?schema=public
# Redis connection string for cache and background jobs (must match Docker Compose)
REDIS_URL=redis://:brainpulses@127.0.0.1:6381
# Signs login tokens — use any long random string locally
JWT_SECRET=change-me-to-a-long-random-secret
# Browser apps allowed to call this API (comma-separated)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
# false = login cookies work over http://localhost
COOKIE_SECURE=false
# 0 = no reverse proxy in front (direct browser → API)
TRUST_PROXY=0
# false = OTP codes print in the API console (no real SMS)
TWILIO_ENABLED=false

# --- Optional ---

# How the browser sends cookies across sites (default: lax)
COOKIE_SAME_SITE=lax
# Folder on disk for uploaded images (default: ./uploads)
UPLOAD_DIR=./uploads
# Local/dev always runs imports, exports, and OTP in the API process (no worker).
# Kept true here for clarity; production uses QUEUE_INLINE=false + PM2 worker.
QUEUE_INLINE=true
# Connections this process may open (default 8). The production worker uses 4.
# DATABASE_POOL_MAX=8
# Authenticated requests per minute, one bucket per login token (default 240)
# RATE_LIMIT_MAX_ACTOR=240
# Anonymous requests per minute, per IP (default 600)
# RATE_LIMIT_MAX_IP=600
