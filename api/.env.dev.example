# Local API settings. Copy to api/.env.dev (do not commit the real file).

# development = local machine
NODE_ENV=development
# 0.0.0.0 = reachable from other devices on your Wi‑Fi
HOST=0.0.0.0
# Port the API listens on (admin/participant expect 3002)
PORT=3002

# Database connection (matches docker-compose defaults)
DATABASE_URL=postgresql://brainpulses:brainpulses@127.0.0.1:5434/brainpulses?schema=public
# Cache/queue connection (matches docker-compose defaults)
REDIS_URL=redis://:brainpulses@127.0.0.1:6381

# Secret used to sign login tokens — change this to any long random string
JWT_SECRET=change-me-to-a-long-random-secret

# Browser apps allowed to call this API (comma-separated). Add tunnel URLs if you use them.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175,https://*.trycloudflare.com
# false = cookies work over http://localhost
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# 0 = you connect straight to the API (no nginx in front)
TRUST_PROXY=0

# Folder where uploaded images are stored
UPLOAD_DIR=./uploads

# true = background jobs run inside the API (no separate worker needed locally)
QUEUE_INLINE=true

# false = login codes print in the API console instead of sending real SMS
TWILIO_ENABLED=false
