{
  "watch": ["src", ".env.dev", ".env"],
  "ext": "ts,json",
  "ignore": [
    "node_modules/**",
    "dist/**",
    "uploads/**",
    "src/generated/**",
    "test/**",
    "**/*.test.ts"
  ],
  "exec": "tsx --conditions=development src/index.ts",
  "delay": "500",
  "signal": "SIGTERM",
  "env": {
    "NODE_ENV": "development"
  }
}
