# Docker Compose credentials for the BrainPulses data stack.
# Copy to .env at the repo root (never commit the real file).
#
# Local UAT may keep the defaults below.
# Production MUST replace every password with a long random value before
# `docker compose up -d`. See docs/ops/DEPLOY.md.

POSTGRES_USER=brainpulses
POSTGRES_PASSWORD=brainpulses
POSTGRES_DB=brainpulses

REDIS_PASSWORD=brainpulses

# Only used with: docker compose --profile tools up -d
CLOUDBEAVER_ADMIN_USER=cbadmin
CLOUDBEAVER_ADMIN_PASSWORD=cbadmin
CLOUDBEAVER_SERVER_URL=http://127.0.0.1:8977/
