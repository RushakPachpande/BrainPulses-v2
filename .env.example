# Docker database and cache passwords. Copy to .env at the repo root (do not commit the real file).
# Local defaults are fine for development. On a live server, use long random passwords.

POSTGRES_USER=brainpulses
POSTGRES_PASSWORD=brainpulses
POSTGRES_DB=brainpulses

REDIS_PASSWORD=brainpulses

# Only needed if you start the optional database UI: docker compose --profile tools up -d
CLOUDBEAVER_ADMIN_USER=cbadmin
CLOUDBEAVER_ADMIN_PASSWORD=cbadmin
CLOUDBEAVER_SERVER_URL=http://127.0.0.1:8977/
