# Docker Compose secrets. Copy to .env at the repo root (do not commit the real file).
# Local defaults are fine for development. On a live server, use long random passwords.

# --- Required ---

# Database login name
POSTGRES_USER=brainpulses
# Database password (must match the password inside api DATABASE_URL)
POSTGRES_PASSWORD=brainpulses
# Database name
POSTGRES_DB=brainpulses
# Redis password (must match the password inside api REDIS_URL)
REDIS_PASSWORD=brainpulses

# --- Optional ---

# Only used with: docker compose --profile tools up -d
# CloudBeaver admin username
CLOUDBEAVER_ADMIN_USER=cbadmin
# CloudBeaver admin password
CLOUDBEAVER_ADMIN_PASSWORD=cbadmin
# CloudBeaver browser URL
CLOUDBEAVER_SERVER_URL=http://127.0.0.1:8977/
