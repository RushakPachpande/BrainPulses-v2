# Live admin settings. Copy to admin/.env.prod (do not commit the real file).
# Values are baked in at production build time.

# --- Required ---

# Public address of the API (used by the built admin site)
VITE_API_URL=url_of_the_api
# Public address of the participant website (used in registration links)
VITE_PARTICIPANT_ORIGIN=url_of_the_participant_website
