# Admin SPA — production Vite build template.
# Copy to admin/.env.production (never commit the real file).
# Values are baked in at `npm run build` time.

VITE_API_URL=https://server.brainpulses.com
VITE_PARTICIPANT_ORIGIN=https://participant.brainpulses.com
VITE_USE_FIXTURES=false

# Unset uses 10MB for images and 5MB for question and answer images.
UPLOAD_IMAGE_SIZE_CAPPING=10MB
QA_UPLOAD_IMAGE_SIZE_CAPPING=5MB
