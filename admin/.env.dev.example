# Local admin settings. Copy to admin/.env.dev (do not commit the real file).

# --- Required ---

# Port for the admin website on your computer
PORT=5173
# false = use the real API; true = use sample/fixture data only
VITE_USE_FIXTURES=false

# --- Optional ---

# API address for preview/build only (`npm run dev` uses the /api proxy instead)
VITE_API_URL=http://localhost:3002
# Local participant app port (used when building registration links)
VITE_PARTICIPANT_DEV_PORT=5174
