# Local admin app settings. Copy to admin/.env (do not commit the real file).

# Port for the admin website on your computer
PORT=5173
# API address (used for preview/build; local `npm run dev` uses the built-in /api proxy instead)
VITE_API_URL=http://localhost:3002
# Port of the participant app on your computer (used in registration links)
VITE_PARTICIPANT_DEV_PORT=5175
# false = talk to the real API; true = use sample data only (local testing)
VITE_USE_FIXTURES=false
