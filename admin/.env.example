# Production builds need an absolute API origin. Local `npm run dev` ignores this
# and uses the Vite `/api` proxy (same-origin) so refresh cookies work with SameSite=lax.
VITE_API_URL=http://localhost:3002
VITE_USE_FIXTURES=false

# Optional: override the Vite proxy target (default http://127.0.0.1:3002)
# VITE_API_PROXY_TARGET=http://127.0.0.1:3002

# Hosts this dev server may answer, besides localhost and IPs.
# Unset allows *.trycloudflare.com. A set value replaces that default (comma-separated).
# A leading dot allows that name and its subdomains. * allows every host. none keeps only Vite's defaults.
# DEV_ALLOWED_HOSTS=.trycloudflare.com,.ngrok-free.app,preview.example.com

# Unset uses 10MB for images and 5MB for question and answer images.
UPLOAD_IMAGE_SIZE_CAPPING=10MB
QA_UPLOAD_IMAGE_SIZE_CAPPING=5MB
